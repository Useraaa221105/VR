  m_Script: {fileID: 11500000, guid: 5507328d844a4ec6a9eceec298b1b965, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Podz.HuntIntro
  _summary: "\u041A\u0410\u041A \u041E\u0425\u041E\u0422\u0418\u0422\u042C\u0421\u042F\r\n\u0417\u0415\u041B\u0401\u041D\u042B\u0419 \u2014 \u0431\u0438\u0442\u044C \u041D\u0415\u041B\u042C\u0417\u042F: \u043B\u0443\u0442 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u0441\u044F; \u0416\u0401\u041B\u0422\u042B\u0419 \u2014 \u043C\u043E\u0436\u043D\u043E \u0431\u0438\u0442\u044C \u043D\u0443\u0436\u043D\u044B\u043C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C; \u041A\u0420\u0410\u0421\u041D\u042B\u0419 \u2014 \u0441\u0435\u0439\u0447\u0430\u0441 \u0443\u0434\u0430\u0440\u0438\u0442\r\n\u041A\u043B\u0430\u0432\u0438\u0448\u0438: 1\u20136 \u2014 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B, B \u2014 \u0431\u0435\u0441\u0442\u0438\u0430\u0440\u0438\u0439, F2 \u2014 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438, C \u2014 \u043F\u0440\u0438\u0441\u0435\u0441\u0442\u044C, E \u2014 \u0441\u0445\u0432\u0430\u0442\u0438\u0442\u044C, \u041B\u041A\u041C \u2014 \u0431\u0438\u0442\u044C\r\n\u041F\u043E\u043D\u044F\u0442\u043D\u043E (Enter)\r\n"
