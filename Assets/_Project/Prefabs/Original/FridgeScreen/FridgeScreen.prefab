--- !u!102 &8574479516554919854
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2668518396292142883}
  m_Text: "\u0421\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \xAB\u0412\u0437\u044F\u0442\u044C\xBB \u0438 \u0436\u043C\u0438 E \u2014\n\u043F\u0440\u043E\u0434\u0443\u043A\u0442 \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0432 \u0440\u0443\u043A\u0435\n(\u0435\u0441\u043B\u0438 \u0432 \u0440\u0443\u043A\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u2014 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0443 \u0434\u043E\u0441\u043A\u0438).\nVR: \u043F\u043E\u0434\u043D\u0435\u0441\u0438 \u0440\u0443\u043A\u0443 \u043A \u043F\u043E\u043B\u043A\u0435 \u0438 \u0441\u043E\u0436\u043C\u0438 grip.\n\u041F\u0443\u0441\u0442\u0430\u044F \u044F\u0447\u0435\u0439\u043A\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0442, \u043A\u043E\u0433\u043E \u0434\u043E\u0431\u044B\u0442\u044C."
  m_OffsetZ: 0
  m_CharacterSize: 0.00390625
